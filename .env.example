# Kopieren nach ".env" und mit echten Werten aus dem Supabase-Dashboard
# (Project Settings -> API) befüllen. Diese Datei wird NUR vom
# einmaligen Setup-Skript (scripts/seed.mjs) gelesen, niemals von der
# eigentlichen Web-App - der service_role-Key darf niemals im Browser
# oder im Frontend-Code landen!

SUPABASE_URL=https://DEIN-PROJEKT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=DEIN-SERVICE-ROLE-KEY
